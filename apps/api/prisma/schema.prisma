generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // "bio", "tagline", "openToWork"
  value     String
  updatedAt DateTime @updatedAt
}

model SiteSection {
  id        String  @id @default(cuid())
  name      String  @unique // "hero", "about", "skills", "projects", "experience", "contact"
  isEnabled Boolean @default(true)
  order     Int
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  category    SkillCategory
  proficiency Int           @default(0)
  icon        String?
  url         String?
}

enum SkillCategory {
  FRONTEND
  BACKEND
  TOOLS
  OTHERS
}

model Profile {
  id        String   @id @default(cuid())
  headline  String // "Full Stack Developer"
  bio       String // About me / summary
  photoUrl  String? // URL dari Supabase Storage
  location  String?
  updatedAt DateTime @updatedAt

  experiences Experience[]
  educations  Education[]
  projects    Project[]
}

model Experience {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id])
  position    String // "Backend Developer"
  company     String // "PT. Example"
  startDate   String // "Jan 2024"
  endDate     String? // null = Present
  description String?
  order       Int
}

model Education {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id])
  institution String // "Politeknik Negeri Bandung"
  major       String // "Teknik Komputer & Informatika"
  startYear   Int
  endYear     Int? // null = masih berjalan
  order       Int
}

model Project {
  id           String   @id @default(cuid())
  githubId     Int?     @unique
  name         String
  description  String?
  customDesc   String? // Override dari admin
  imageUrl     String? // URL gambar preview proyek
  url          String
  language     String?
  stars        Int      @default(0)
  tags         String[] // Custom tags dari admin
  isPinned     Boolean  @default(false)
  isVisible    Boolean  @default(true)
  lastSyncedAt DateTime?
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SyncLog {
  id       String     @id @default(cuid())
  source   SyncSource @default(GITHUB)
  status   SyncStatus
  message  String?
  syncedAt DateTime   @default(now())
}

enum SyncSource {
  GITHUB
}

enum SyncStatus {
  SUCCESS
  FAILED
}
